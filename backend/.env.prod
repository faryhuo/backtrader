# Production environment variables
HOST=0.0.0.0
PORT=8000

# Replace with your production credentials before deployment
OPENAI_API_KEY=replace-with-production-openai-key
OPENAI_BASE_URL=https://api.gptgod.online/v1/

# Logto authorization (update for your deployed domain)
LOGTO_ISSUER=https://logto.fary.chat/oidc
LOGTO_JWKS_URI=https://logto.fary.chat/oidc/jwks
LOGTO_AUDIENCE=https://your-domain.com/api
# Optional space separated scopes, e.g. "read:trades write:trades"
LOGTO_REQUIRED_SCOPES=
