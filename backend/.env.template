# ============================================================================
# CORS (Frontend / Browser Access)
# ============================================================================
# Comma-separated list of allowed origins (no trailing slash).
# Example: CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-domain.com
CORS_ALLOW_ORIGINS=*
# Optional regex-based origin allowlist (use carefully).
# Example: CORS_ALLOW_ORIGIN_REGEX=^https://.*\\.your-domain\\.com$
CORS_ALLOW_ORIGIN_REGEX=
# If true, enables cookies/Authorization across origins. MUST NOT be used with "*" origins.
CORS_ALLOW_CREDENTIALS=false

