# ============================================================================
# Sensitive Configuration - Fill in your values below
# Non-sensitive settings are managed via resources/config/*.json
# ============================================================================

# ---- Encryption ----
# Fernet key for encrypting stored credentials (e.g. exchange API keys)
# Leave empty to let the onboarding wizard generate one on first save
ENCRYPTION_KEY=

# ---- Authentication ----
ENABLE_LOGIN=false
AUTH_PROVIDER=none
SYSTEM_AUTH_ALLOW_REGISTRATION=false
SYSTEM_AUTH_SECRET=

# Logto Authorization (fill when ENABLE_LOGIN=true)
LOGTO_ISSUER=
LOGTO_JWKS_URI=
LOGTO_AUDIENCE=
LOGTO_REQUIRED_SCOPES=
LOGTO_ENDPOINT=
LOGTO_APP_ID=
LOGTO_REDIRECT_URI=
LOGTO_POST_LOGOUT_REDIRECT_URI=

# ---- AI & Data Sources ----
# AI provider priority fallback order
AI_PROVIDER=openai
AI_PROVIDER_PRIORITY=openai,minimax,gemini,claude
OPENAI_API_KEY=
# Leave empty to use OpenAI default: https://api.openai.com/v1
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.1
MINIMAX_API_KEY=
# Leave empty to use MiniMax default: https://api.minimaxi.com/anthropic
MINIMAX_BASE_URL=
MINIMAX_MODEL=MiniMax-M2.7
GEMINI_API_KEY=
# Leave empty to use Gemini default: https://generativelanguage.googleapis.com/v1beta
GEMINI_BASE_URL=
GEMINI_MODEL=gemini-2.0-flash
CLAUDE_API_KEY=
# Leave empty to use Claude default: https://api.anthropic.com/v1
CLAUDE_BASE_URL=
CLAUDE_MODEL=claude-3-5-haiku-latest
EODHD_API_KEY=

# ---- Reporting ----
REPORT_SHARE_SECRET=default-secret-change-me-in-production
REPORT_MAX_AGE_DAYS=30

# ---- Proxy ----
HTTP_PROXY=
HTTPS_PROXY=

# ---- Trading ----
LIVE_TRADING_ENABLED=false
DEFAULT_EXCHANGE=binance
DEFAULT_TRADE_MODE=paper

# ============================================================================
# Exchange API Credentials
# Format: CCXT_BINANCE_{MODE}_API_KEY / CCXT_BINANCE_{MODE}_SECRET
# MODE: PAPER (testnet) or LIVE (production)
# IMPORTANT: Always test with PAPER mode first!
# ============================================================================

# ---------- Binance ----------
# Get testnet keys from: https://testnet.binance.vision/
CCXT_BINANCE_PAPER_API_KEY=
CCXT_BINANCE_PAPER_SECRET=
CCXT_BINANCE_LIVE_API_KEY=
CCXT_BINANCE_LIVE_SECRET=
