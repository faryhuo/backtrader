# Backend Environment Variables Template
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env to version control!

# ============================================================================
# Encryption Key for Database Credentials
# ============================================================================
# REQUIRED: Generate an encryption key for storing credentials in database
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Or run: python -m src.utils.encryption
ENCRYPTION_KEY=4g9eQqfX4MPmEBdQXKLrDQdSVVutj8RTL3uF-SnGOY1I=

# NOTE: All credentials below can also be configured via the Settings UI
# Database values take precedence over .env values when both are set
# This provides backward compatibility while enabling UI-based configuration

# ============================================================================
# Authentication / Platform Configuration
# ============================================================================
# Logto Authentication - All settings can be managed via Settings UI
# If not configured, login will be automatically disabled

# Authentication toggle
ENABLE_LOGIN=false

# Server-side JWT validation
LOGTO_ISSUER=                            # Logto issuer URL (e.g., https://logto.yourdomain.com)
LOGTO_JWKS_URI=                          # JWKS endpoint (e.g., https://logto.yourdomain.com/oidc/jwks)
LOGTO_AUDIENCE=                          # API audience (e.g., https://api.yourdomain.com)
LOGTO_REQUIRED_SCOPES=                   # Required OAuth scopes (e.g., openid profile email)

# Frontend OAuth 2.0 flow
LOGTO_ENDPOINT=                          # Logto server endpoint (same as LOGTO_ISSUER typically)
LOGTO_APP_ID=                            # Application (client) ID from Logto console
LOGTO_REDIRECT_URI=                      # OAuth callback URL (e.g., http://localhost:5173/callback)
LOGTO_POST_LOGOUT_REDIRECT_URI=          # Post-logout redirect (e.g., http://localhost:5173/login)

# ============================================================================
# External Services
# ============================================================================
DATABASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional HTTP/HTTPS Proxies
HTTP_PROXY=
HTTPS_PROXY=

# ============================================================================
# Live Trading Configuration
# ============================================================================
LIVE_TRADING_ENABLED=false
DEFAULT_EXCHANGE=binance
DEFAULT_TRADE_MODE=paper

# ============================================================================
# CORS (Frontend / Browser Access)
# ============================================================================
# Comma-separated list of allowed origins (no trailing slash).
# Example: CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-domain.com
CORS_ALLOW_ORIGINS=*
# Optional regex-based origin allowlist (use carefully).
# Example: CORS_ALLOW_ORIGIN_REGEX=^https://.*\\.your-domain\\.com$
CORS_ALLOW_ORIGIN_REGEX=
# If true, enables cookies/Authorization across origins. MUST NOT be used with "*" origins.
CORS_ALLOW_CREDENTIALS=false

# ============================================================================
# CCXT Exchange API Credentials
# ============================================================================
# Format: CCXT_{EXCHANGE}_{MODE}_API_KEY
# MODE: PAPER (for testnet/sandbox) or LIVE (for production)
# IMPORTANT: Always test with PAPER mode before using LIVE!

# ---------- Binance ----------
# Get testnet keys from: https://testnet.binance.vision/
CCXT_BINANCE_PAPER_API_KEY=your_binance_testnet_api_key
CCXT_BINANCE_PAPER_SECRET=your_binance_testnet_secret

# Production keys (ONLY after thorough testing with paper trading!)
CCXT_BINANCE_LIVE_API_KEY=
CCXT_BINANCE_LIVE_SECRET=

# ---------- OKX ----------
# Get testnet keys from: https://www.okx.com/account/my-api
# OKX requires a passphrase
CCXT_OKX_PAPER_API_KEY=
CCXT_OKX_PAPER_SECRET=
CCXT_OKX_PAPER_PASSPHRASE=

CCXT_OKX_LIVE_API_KEY=
CCXT_OKX_LIVE_SECRET=
CCXT_OKX_LIVE_PASSPHRASE=

# ---------- Bybit ----------
# Get testnet keys from: https://testnet.bybit.com/
CCXT_BYBIT_PAPER_API_KEY=
CCXT_BYBIT_PAPER_SECRET=

CCXT_BYBIT_LIVE_API_KEY=
CCXT_BYBIT_LIVE_SECRET=

# ============================================================================
# Risk Management Overrides (Optional)
# ============================================================================
# These override values in broker_config.json
# MAX_POSITION_SIZE_USD=5000
# MAX_DAILY_LOSS_USD=500
# MAX_POSITIONS_COUNT=5

# ============================================================================
# Security Notes
# ============================================================================
# 1. NEVER commit .env to git (ensure .env is in .gitignore)
# 2. Use separate API keys for paper and live trading
# 3. For live trading, create API keys with:
#    - Trading permissions ONLY (no withdrawal permissions)
#    - IP whitelist restrictions if possible
#    - 2FA enabled on your exchange account
# 4. Start with small position sizes in live trading
# 5. Monitor your first live trades closely

# ============================================================================
# Strategy & Worker Pool Configuration
# ============================================================================
# NOTE: Sandbox and Worker Pool configuration has been moved to:
#   resources/config/strategy_config.json
# See that file for all available options.

# ============================================================================
# Site Configuration (Landing Page)
# ============================================================================
# Customize the landing page content without code changes.
# All values are optional and have sensible defaults.

# Site branding
SITE_TITLE=Backtrader Pro
SITE_DESCRIPTION=Professional quantitative trading platform

# External links (displayed in footer and CTA section)
SITE_DOCS_URL=
SITE_GITHUB_URL=
SITE_TWITTER_URL=
SITE_EMAIL=

# Stats displayed on landing page hero section
SITE_STATS_STRATEGIES=50+
SITE_STATS_BACKTESTS=10K+
SITE_STATS_USERS=1K+