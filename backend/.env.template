# ============================================================================
# Sensitive Configuration - Fill in your values below
# Non-sensitive settings are managed via resources/config/*.json
# ============================================================================

# ---- Encryption ----
# REQUIRED: Fernet key for encrypting stored credentials (e.g. exchange API keys)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ---- Authentication ----
ENABLE_LOGIN=false

# Logto Authorization (fill when ENABLE_LOGIN=true)
LOGTO_ISSUER=
LOGTO_JWKS_URI=
LOGTO_AUDIENCE=
LOGTO_REQUIRED_SCOPES=
LOGTO_ENDPOINT=
LOGTO_APP_ID=
LOGTO_REDIRECT_URI=
LOGTO_POST_LOGOUT_REDIRECT_URI=

# ---- AI & Data Sources ----
AI_PROVIDER=openai
AI_PROVIDER_PRIORITY=openai,minimax,gemini,claude
OPENAI_API_KEY=
# Leave empty to use OpenAI default: https://api.openai.com/v1
OPENAI_BASE_URL=
MINIMAX_API_KEY=
MINIMAX_BASE_URL=
GEMINI_API_KEY=
# Leave empty to use Gemini default: https://generativelanguage.googleapis.com/v1beta
GEMINI_BASE_URL=
CLAUDE_API_KEY=
# Leave empty to use Claude default: https://api.anthropic.com/v1
CLAUDE_BASE_URL=
EODHD_API_KEY=

# ---- Reporting ----
REPORT_SHARE_SECRET=default-secret-change-me-in-production

# ---- Proxy ----
HTTP_PROXY=
HTTPS_PROXY=

# ============================================================================
# Exchange API Credentials
# Format: CCXT_{EXCHANGE}_{MODE}_API_KEY / CCXT_{EXCHANGE}_{MODE}_SECRET
# MODE: PAPER (testnet) or LIVE (production)
# IMPORTANT: Always test with PAPER mode first!
# ============================================================================

# ---------- Binance ----------
# Get testnet keys from: https://testnet.binance.vision/
CCXT_BINANCE_PAPER_API_KEY=
CCXT_BINANCE_PAPER_SECRET=
CCXT_BINANCE_LIVE_API_KEY=
CCXT_BINANCE_LIVE_SECRET=

# ---------- OKX ----------
# Get testnet keys from: https://www.okx.com/
CCXT_OKX_PAPER_API_KEY=
CCXT_OKX_PAPER_SECRET=
CCXT_OKX_PAPER_PASSPHRASE=
CCXT_OKX_LIVE_API_KEY=
CCXT_OKX_LIVE_SECRET=
CCXT_OKX_LIVE_PASSPHRASE=

# ---------- Bybit ----------
# Get testnet keys from: https://bybit-exchange.github.io/
CCXT_BYBIT_PAPER_API_KEY=
CCXT_BYBIT_PAPER_SECRET=
CCXT_BYBIT_LIVE_API_KEY=
CCXT_BYBIT_LIVE_SECRET=
