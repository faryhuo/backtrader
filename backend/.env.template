# 5. Monitor your first live trades closely

# ============================================================================
# Strategy Sandbox Configuration
# ============================================================================
# SECURITY WARNING: Read SECURITY.md before deploying to multi-user/public environments!
#
# The sandbox provides layered security but has KNOWN LIMITATIONS:
# - pandas/numpy can perform file I/O operations
# - Python reflection can bypass some restrictions
# - Main process still executes validated code
#
# SAFE USE CASES: Single-user deployment, trusted team environment
# UNSAFE USE CASES: Public SaaS, multi-tenant, untrusted user code
#
# For production multi-tenant deployments, consider:
# - Running backtests in isolated containers
# - Implementing strategy review workflows
# - Using network isolation (--network=none)
# ============================================================================

# Sandbox mode for executing user strategy code
# Options:
#   - soft: In-process execution (INSECURE - for development only)
#   - subprocess: Process isolation with resource limits (RECOMMENDED)
#   - docker: Container isolation (most secure, requires Docker)
SANDBOX_MODE=subprocess

# Execution timeout in seconds (strategy validation + execution)
# Lower values provide better DoS protection but may fail complex strategies
SANDBOX_TIMEOUT_SECONDS=30.0

# Maximum memory usage in megabytes per sandbox instance
# Note: Hard limits only enforced on Linux; Windows uses monitoring only
SANDBOX_MAX_MEMORY_MB=512

# Maximum CPU usage percentage (currently only enforced on Linux)
SANDBOX_MAX_CPU_PERCENT=100

# Allow network access in sandbox
# WARNING: Setting to true allows data exfiltration via pandas.read_csv(url)
SANDBOX_ALLOW_NETWORK=false

# Allow file write operations in sandbox
# WARNING: Setting to true allows strategies to write arbitrary files
SANDBOX_ALLOW_FILE_WRITE=false

# Docker image for container mode (only used when SANDBOX_MODE=docker)
SANDBOX_DOCKER_IMAGE=python:3.11-slim

