{
  "version": "1.0",
  "exchanges": {
    "binance": {
      "enabled": true,
      "name": "Binance",
      "adapter": "ccxt",
      "ccxt_id": "binance",
      "markets": [
        "spot",
        "futures"
      ],
      "default_market": "spot",
      "paper_mode": {
        "enabled": true,
        "sandbox_url": "https://testnet.binance.vision",
        "initial_balance_usdt": 10000.0
      }
    }
  },
  "risk_management": {
    "position_limits": {
      "max_position_size_usd": 10000000.0,
      "max_positions_count": 5,
      "max_leverage": 1
    },
    "loss_limits": {
      "max_daily_loss_usd": 500.0,
      "max_daily_loss_percent": 5.0,
      "max_drawdown_percent": 10.0
    },
    "order_limits": {
      "min_order_size_usd": 10.0,
      "max_order_size_usd": 10000000.0,
      "max_slippage_percent": 1.0
    }
  },
  "trading_settings": {
    "default_timeframe": "1m",
    "supported_timeframes": [
      "1s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h",
      "4h",
      "1d"
    ]
  },
  "notifications": {
    "enabled": true,
    "channels": [
      "websocket"
    ],
    "events": [
      "order_filled",
      "position_opened",
      "position_closed",
      "error",
      "risk_alert"
    ]
  }
}
