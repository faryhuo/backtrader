{
    "version": "1.0",
    "logging": {
        "level": "INFO",
        "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
        "date_format": "%Y-%m-%d %H:%M:%S",
        "handlers": {
            "console": {
                "level": "INFO",
                "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
            },
            "file": {
                "level": "DEBUG",
                "filename": "logs/app.log",
                "max_bytes": 10485760,
                "backup_count": 5,
                "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
            }
        }
    },
    "loggers": {
        "root": {
            "level": "INFO",
            "handlers": [
                "console",
                "file"
            ]
        }
    }
}
