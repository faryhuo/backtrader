{
  "version": "1.0",
  "description": "Broker configuration template for live/paper trading. Copy this file to broker_config.json and customize.",
  "exchanges": {
    "binance": {
      "enabled": true,
      "name": "Binance",
      "adapter": "ccxt",
      "ccxt_id": "binance",
      "markets": ["spot", "futures"],
      "default_market": "spot",
      "paper_mode": {
        "enabled": true,
        "sandbox_url": "https://testnet.binance.vision",
        "initial_balance_usdt": 10000
      },
      "rate_limits": {
        "orders_per_second": 10,
        "requests_per_minute": 1200
      }
    },
    "okx": {
      "enabled": false,
      "name": "OKX",
      "adapter": "ccxt",
      "ccxt_id": "okx",
      "markets": ["spot", "swap"],
      "default_market": "spot",
      "paper_mode": {
        "enabled": true,
        "sandbox_url": "https://www.okx.com",
        "initial_balance_usdt": 10000
      },
      "rate_limits": {
        "orders_per_second": 20,
        "requests_per_minute": 1200
      },
      "notes": "OKX requires passphrase in environment variables (CCXT_OKX_PAPER_PASSPHRASE or CCXT_OKX_LIVE_PASSPHRASE)"
    },
    "bybit": {
      "enabled": false,
      "name": "Bybit",
      "adapter": "ccxt",
      "ccxt_id": "bybit",
      "markets": ["spot", "linear"],
      "default_market": "spot",
      "paper_mode": {
        "enabled": true,
        "sandbox_url": "https://api-testnet.bybit.com",
        "initial_balance_usdt": 10000
      },
      "rate_limits": {
        "orders_per_second": 10,
        "requests_per_minute": 600
      }
    },
    "ibkr": {
      "enabled": false,
      "name": "Interactive Brokers",
      "adapter": "ibkr",
      "ccxt_id": "ibkr",
      "markets": ["stock", "forex", "futures", "options"],
      "default_market": "stock",
      "paper_mode": {
        "enabled": true,
        "sandbox_url": null,
        "initial_balance_usdt": 100000
      },
      "rate_limits": null,
      "notes": "Requires IB Gateway/TWS; configure IBKR_{MODE}_HOST/PORT/CLIENT_ID/ACCOUNT env vars."
    }
  },
  "risk_management": {
    "position_limits": {
      "max_position_size_usd": 5000,
      "max_positions_count": 5,
      "max_leverage": 1,
      "notes": "Adjust these limits based on your risk tolerance"
    },
    "loss_limits": {
      "max_daily_loss_usd": 500,
      "max_daily_loss_percent": 5,
      "max_drawdown_percent": 10,
      "notes": "Trading will be halted if any of these limits are exceeded"
    },
    "order_limits": {
      "min_order_size_usd": 10,
      "max_order_size_usd": 5000,
      "max_slippage_percent": 1,
      "notes": "Orders outside these bounds will be rejected"
    }
  },
  "trading_settings": {
    "default_timeframe": "1m",
    "supported_timeframes": ["1m", "5m", "15m", "30m", "1h", "4h", "1d"],
    "reconnect_on_disconnect": true,
    "max_reconnect_attempts": 5,
    "heartbeat_interval_seconds": 30
  },
  "notifications": {
    "enabled": true,
    "channels": ["websocket"],
    "events": ["order_filled", "position_opened", "position_closed", "error", "risk_alert"],
    "notes": "WebSocket notifications will be sent for these events"
  },
  "instructions": {
    "1_setup": "Copy this template to broker_config.json",
    "2_exchanges": "Enable exchanges you want to use by setting 'enabled': true",
    "3_api_keys": "Set API keys in .env file (see .env.template)",
    "4_risk_limits": "Adjust risk_management limits based on your risk tolerance",
    "5_testing": "Always test with paper trading (testnet) before enabling live trading"
  }
}
