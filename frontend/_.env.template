# Frontend environment template (Vite)
#
# Usage:
# - Copy this file to `frontend/.env` (or `.env.local`) and fill in your own values.
# - Only variables prefixed with `VITE_` are exposed to the frontend.
#
# NOTE: This template intentionally does not include real/production credentials or URLs.

# Logto Authentication Configuration (Development)
# Example: https://logto.example.com
VITE_LOGTO_ENDPOINT=

# Logto application (client) ID
VITE_LOGTO_APP_ID=

# OAuth redirect URIs registered in Logto (typically your dev server)
# Example: http://localhost:5173/callback
VITE_LOGTO_REDIRECT_URI=

# Example: http://localhost:5173/login
VITE_LOGTO_POST_LOGOUT_REDIRECT_URI=

# Backend API (default FastAPI dev server)
VITE_API_BASE_URL=http://localhost:8000
VITE_API_RESOURCE=http://localhost:8000/api

# Enable/disable login flow in the UI
VITE_ENABLE_LOGIN=false
