# Test Environment Configuration Template
# Copy this file to .env.test and fill in the values

# API Configuration
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
LOGTO_AUDIENCE=http://localhost:8000/api

# Database Configuration (for test data management)
TEST_DB_PATH=test/trading_sessions.db

# Authentication (if using real auth)
# TEST_USER_TOKEN=your_test_jwt_token_here
# TEST_USER_ID=test_user_id
# TEST_USERNAME=testuser

# Exchange API Keys (if testing with real exchange APIs in paper mode)
# BINANCE_API_KEY=your_test_api_key
# BINANCE_API_SECRET=your_test_api_secret

# Test Execution Settings
HEADLESS_BROWSER=true
BROWSER_TYPE=chromium  # chromium, firefox, or webkit
BROWSER_SLOW_MO=0  # Milliseconds to slow down browser operations (for debugging)

# Optional: Screenshot on failure
SCREENSHOT_ON_FAILURE=true
SCREENSHOT_DIR=./test_screenshots
